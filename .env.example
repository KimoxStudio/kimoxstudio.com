# Contact form delivery (Resend) — required in production
# Sign up: https://resend.com  (free tier: 100 emails/day, 3 000/month)
# 1. Verify your domain in the Resend dashboard (DNS records on Vercel).
# 2. Create an API key with Sending Access.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# From address. Must use a domain you've verified in Resend. For quick
# testing you can keep "onboarding@resend.dev" (default if not set).
RESEND_FROM="Kimox Studio <hola@kimoxstudio.com>"
# Where contact messages land.
RESEND_TO=kimoxstudio@gmail.com

# Rate limiting — optional in dev, required in production.
# Two ways to provision; both work, the code reads either set:
#
# A. Vercel Marketplace (recommended)
#    Vercel project → Storage → "Create" → pick Upstash Redis (or any
#    Redis integration). Vercel auto-injects KV_REST_API_URL +
#    KV_REST_API_TOKEN into the project's env.
#
# B. Direct Upstash (https://upstash.com)
#    Create a Redis database, then copy the REST URL + token here.
UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=AY...your_token...

# ---------------------------------------------------------------------------
# kimox-fw admin (mounted at /admin) — content editor for content/pages/*.
#
# These values are public (they live in this file), so in PRODUCTION the app
# refuses to use them: a missing/blank secret becomes a random per-boot value.
# The public site keeps serving normally, but /admin is effectively locked
# until you set real values (in Vercel: Project → Settings → Environment
# Variables). Locally they are fine — `pnpm dev` boots with admin/admin.
KX_ADMIN_USER=admin
KX_ADMIN_PASSWORD=admin
KX_SESSION_SECRET=change-me
KX_COOKIE_SECRET=change-me

# ---------------------------------------------------------------------------
# Content persistence. Without any of the vars below the site runs on the
# in-memory stub provider: the public site renders from the committed
# content/ tree, but admin edits do NOT persist (and on serverless each
# instance has its own memory). Set these to make /admin a real CMS.
#
# `pnpm kx setup` walks you through GitHub step by step and writes .env.local.
#
# Simple / single-user — a fine-grained token with Contents: read & write:
# KX_GITHUB_OWNER / KX_GITHUB_REPO / KX_GITHUB_ACCESS_TOKEN
#
# Production — a GitHub App installation (auto-renewing, scoped):
# KX_GITHUB_OWNER / KX_GITHUB_REPO / KX_GITHUB_APP_ID /
# KX_GITHUB_APP_PRIVATE_KEY / KX_GITHUB_INSTALLATION_ID
#
# Webhook secret: lets pushes/merges invalidate the production content cache.
# Without it, content published outside the admin won't appear until restart.
KX_GITHUB_WEBHOOK_SECRET=
